# Copy to .env for local development: `npm run dev` and `npm start` load it
# automatically via node's --env-file-if-exists.

# Port the MCP server binds on.
PORT=4400

# Interface to bind.
#   local dev  -> 127.0.0.1 (loopback only)
#   CONTAINER  -> 0.0.0.0   (the network namespace is the isolation boundary;
#                            the host's `--publish 127.0.0.1:...` is what limits
#                            exposure. Binding the container's loopback makes the
#                            published port unreachable on some rootless backends.)
BIND_HOST=127.0.0.1

# Public URL this resource server is reachable at. Used for RFC 9728
# protected-resource metadata and for the resource identifier on issued AuthInfo.
# PRODUCTION MUST OVERRIDE THIS — if it is left at localhost the server advertises
# a localhost metadata URL and every OAuth-capable client breaks.
PUBLIC_URL=http://localhost:4400

# Authorization server clients are told to get a token from (RFC 8414 issuer),
# published in the protected-resource metadata. There is no authorization server
# yet, so this currently points at this host, which serves no AS metadata — see
# the "Known gap" note in README.md.
AUTH_ISSUER_URL=http://localhost:4400

# TEMPORARY stub auth. Comma-separated `token:subject:scope|scope` entries.
# Tokens and subjects may not contain ":". Malformed entries are rejected at
# startup. Replace with a real OAuth 2.1 authorization server before any rollout:
# anyone holding one of these strings is fully authorized.
MARS_STUB_TOKENS=replace-me-dev-only:gene:mars.read
