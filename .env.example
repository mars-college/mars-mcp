# Copy to .env for LOCAL development; chmod 600 .env. Never commit real secrets.
# npm run dev / npm start load .env. Hosted env files stay in private operator storage.
PORT=4400
BIND_HOST=127.0.0.1
PUBLIC_URL=http://localhost:4400

# Register PUBLIC_URL + /auth/discord/callback in the Discord Developer Portal.
# User OAuth scopes: identify guilds.members.read. A bot token is not required.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Numeric Discord role ID -> community role. All accepted guild members get member.
DISCORD_ROLE_MAP={}
# Demo: DISCORD_ROLE_MAP={"123456789012345678":"demo-reader"}

# Sessions expire at most this many seconds after the Discord membership check.
# Range 60..900; no refresh tokens. Role removal takes effect within this bound.
AUTH_SESSION_TTL=900
# Local default: $XDG_STATE_HOME/mars-mcp/auth.sqlite, or ~/.local/state/mars-mcp/auth.sqlite.
# The parent must be a dedicated private directory (0700); file is created 0600.
# AUTH_DATABASE_PATH=/absolute/private/path/auth.sqlite

# Optional LOCAL operator catalog: set BOTH paths, outside this checkout.
# Unset both to serve only the packaged synthetic demo. Restart after changes.
# Paths below are placeholders, not existing/private archive locations.
# MARS_RESOURCE_CATALOG=/absolute/private/path/resources.json
# MARS_RESOURCE_ROOT=/absolute/private/path/context

# Hosted operation requires an HTTPS PUBLIC_URL and approved network binding.
# The generic service example configures persistent auth state separately.
# No private resources or storage locations are declared in this template.

# Permanent service bearers: raw tokens stay only in the calling service's env.
# MARS_SERVICE_PRINCIPALS=[{"name":"example-agent","tokenSha256":"<64 lowercase hex characters>","roles":["mars-2027"]}]
MARS_SERVICE_PRINCIPALS=[]
# Optional role-gated integrations. Never commit real origins or tokens.
CUELIGHT_URL=
CUELIGHT_TOKEN=
MARS_GATEWAY_URL=
MARS_GATEWAY_TOKEN=
