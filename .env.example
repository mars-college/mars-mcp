# Port the MCP server binds on (loopback only; Caddy terminates TLS in front)
PORT=4400
BIND_HOST=127.0.0.1

# Public URL this resource server is reachable at. Used for RFC 9728
# protected-resource metadata and audience checks.
PUBLIC_URL=https://mcp.mars.college

# Authorization server that will eventually issue tokens (RFC 8414 issuer).
# Not yet used for verification — see src/auth.ts.
AUTH_ISSUER_URL=https://mcp.mars.college

# TEMPORARY stub auth. Comma-separated "token:subject:scopes|scopes" entries.
# Replace with a real OAuth 2.1 authorization server before any real rollout.
MARS_STUB_TOKENS=dev-token-change-me:gene:mars.read,dev-token-jmill:jmill:mars.read
