# systemd --user unit for the `mars` account on eden2.
#
#   loginctl enable-linger mars          # required, or this dies at logout
#   install -D -m644 mars-mcp.service ~/.config/systemd/user/mars-mcp.service
#   systemctl --user daemon-reload && systemctl --user enable --now mars-mcp
[Unit]
Description=Mars College MCP server
After=network-online.target
Wants=network-online.target

[Service]
# Declared here rather than read from the env file: systemd only needs the port to
# build the publish flag, and sourcing the env file would also copy
# MARS_STUB_TOKENS into the podman client's own environment (/proc/<pid>/environ)
# and run the secrets through a second, differently-quoting parser.
#
# TRADE-OFF: this PORT and the PORT in ~/mars-mcp.env are now two separate values
# and MUST match. If they diverge, podman publishes a port nothing is listening on,
# every request through Caddy gets connection-refused, and the unit still reports
# active (running) with nothing in the log.
Environment=CONTAINER=mars-mcp
Environment=PORT=4400
# --init gives the container a real init as PID 1 so SIGTERM is delivered rather
# than dropped; without it every restart waits out the full stop timeout and then
# SIGKILLs, severing in-flight responses.
ExecStartPre=-/usr/bin/podman rm -f ${CONTAINER}
# The Discord archive is mounted READ-ONLY from a 0700 mars:mars directory on the
# host. It is deliberately NOT copied into the image: the image is rebuilt on every
# deploy and its layers are readable by anyone who can pull it, while the host
# directory is unreadable to uid 1000 (eden), which is what the eden3 API and the
# OpenClaw agent gateway run as. The MCP server is the only thing that opens it.
# --userns=keep-id:uid=1000,gid=1000 maps the host `mars` account onto the image's
# `node` user. Without it, rootless podman maps container uid 1000 into mars's
# subuid range (166535), which cannot read a 0700 mars:mars directory — the
# archive mount would silently be Permission denied.
ExecStart=/usr/bin/podman run --rm --init --name ${CONTAINER} \
    --env-file %h/mars-mcp.env \
    --userns=keep-id:uid=1000,gid=1000 \
    --volume /srv/mars-mcp-data:/data:ro \
    --publish 127.0.0.1:${PORT}:${PORT} \
    localhost/mars-mcp:latest
ExecStop=/usr/bin/podman stop -t 10 ${CONTAINER}
TimeoutStopSec=20
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
